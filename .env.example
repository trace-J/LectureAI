# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional. The app creates a "Lecture Notes" folder in My Drive on first
# upload and files courses under it, so you normally leave these alone.
# DRIVE_ROOT_FOLDER_NAME=Lecture Notes
# DRIVE_PARENT_FOLDER_ID=

# Optional. Which microphone record.py uses, as a substring of the device name
# (see: python record.py --list-devices). Names beat indices, which get
# reshuffled whenever a phone or headset connects.
# RECORD_DEVICE=MacBook Pro Microphone

# Optional. Send lecture action items to a Notion to-do database as dated
# tasks. Leave unset to skip Notion entirely. Create an integration at
# notion.so/my-integrations, then share your database with it (database ...
# menu, Connections), or every call returns 404.
# NOTION_TOKEN=ntn_...
# NOTION_DATABASE=https://www.notion.so/...

# Optional. Only if `python notion_tasks.py --check` maps a property wrong.
# Use the exact property name from your database.
# NOTION_PROP_DUE=Deadline
# NOTION_PROP_COURSE=Class
# NOTION_PROP_KIND=Type
# NOTION_PROP_SOURCE=Link
